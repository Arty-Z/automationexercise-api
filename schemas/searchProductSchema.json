{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SearchProductResponse",
  "type": "object",
  "required": ["responseCode", "products"],
  "properties": {
    "responseCode": {
      "type": "number",
      "description": "HTTP response code"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "price", "brand"],
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "category": {
            "type": "object"
          }
        }
      }
    }
  }
}

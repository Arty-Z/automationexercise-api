    {
      "name": "Brands",
      "item": [
        {
          "name": "Get Brands List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has brands array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('brands');",
                  "    pm.expect(jsonData.brands).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Brands have required fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.brands.forEach(function(brand) {",
                  "        pm.expect(brand).to.have.property('id');",
                  "        pm.expect(brand).to.have.property('brand');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
